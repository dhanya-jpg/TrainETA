{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "email": { "type": "string", "required": true },
        "displayName": { "type": "string", "required": false },
        "role": { "type": "string", "required": false },
        "createdAt": { "type": "string", "required": true },
        "lastLoginAt": { "type": "string", "required": true },
        "preferredLanguage": { "type": "string", "required": false }
      }
    },
    "UserAlert": {
      "collection": "users/{userId}/alerts",
      "fields": {
        "trainNumber": { "type": "string", "required": true },
        "trainName": { "type": "string", "required": true },
        "stationCode": { "type": "string", "required": true },
        "stationName": { "type": "string", "required": true },
        "notifyMinutesBefore": { "type": "number", "required": true },
        "platformChangeAlert": { "type": "boolean", "required": true },
        "wakeUpAlarm": { "type": "boolean", "required": true },
        "createdAt": { "type": "string", "required": true }
      }
    },
    "RecentSearch": {
      "collection": "users/{userId}/recentSearches",
      "fields": {
        "trainNumber": { "type": "string", "required": true },
        "trainName": { "type": "string", "required": true },
        "searchedAt": { "type": "string", "required": true },
        "source": { "type": "string", "required": false },
        "destination": { "type": "string", "required": false }
      }
    }
  }
}
